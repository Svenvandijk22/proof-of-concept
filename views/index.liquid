{% render 'partials/head.liquid' %}


<section class="product-gallery">

  <div class="gallery-main">

    <div class="gallery-counter">
      <span>1</span> / <span>4</span>
    </div>

    <button
      class="gallery-zoom-button"
      aria-label="Open image fullscreen"
    >
      <img src="./assets/icons/zoom.svg" alt="">
    </button>

    <img
      class="gallery-main-image"
      src="./assets/images/bike-1.webp"
      alt="Triban EDR Easy road bike"
    >

  </div>

  <ul class="gallery-thumbnails">

    <li>
      <a
        class="gallery-thumbnail active"
        href="./assets/images/bike-1.webp"
      >
        <img
          src="./assets/images/bike-1.webp"
          alt="Road bike image 1"
        >
      </a>
    </li>

    <li>
      <a
        class="gallery-thumbnail"
        href="./assets/images/bike-2.webp"
      >
        <img
          src="./assets/images/bike-2.webp"
          alt="Road bike image 2"
        >
      </a>
    </li>

    <li>
      <a
        class="gallery-thumbnail"
        href="./assets/images/bike-3.webp"
      >
        <img
          src="./assets/images/bike-3.webp"
          alt="Road bike image 3"
        >
      </a>
    </li>

    <li>
      <a
        class="gallery-thumbnail"
        href="./assets/images/bike-4.webp"
      >
        <img
          src="./assets/images/bike-4.webp"
          alt="Road bike image 4"
        >
      </a>
    </li>

  </ul>

</section>




{% render 'partials/foot.liquid' %}