{% render 'partials/head.liquid' %}


<section class="product-gallery">
  <div class="gallery-main">
 

    <img
      class="gallery-main-image"
      src="{{ images.first }}"
      alt="{{ product.title }}"
    >
  </div>

  <ul class="gallery-thumbnails">
    {% for image in images %}
      <li>
        <a
          class="gallery-thumbnail {% if forloop.first %}active{% endif %}"
          href="{{ image }}"
        >
          <img
            src="{{ image }}"
            alt="{{ product.title }}"
          >
        </a>
      </li>
    {% endfor %}
  </ul>
</section>

<div class="zoom-overlay">
  <div class="zoom-modal">
    <button class="zoom-close" aria-label="Close zoom">✕</button>

    <button class="zoom-arrow zoom-arrow-left" aria-label="Previous image">‹</button>

    <div class="zoom-image-wrapper">
      <img class="zoom-image" src="" alt="">
    </div>

  </div>
</div>
</body>

{% render 'partials/foot.liquid' %}